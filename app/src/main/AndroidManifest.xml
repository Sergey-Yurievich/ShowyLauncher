<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Linked TVs find each other by UDP broadcast (Sync); Wi-Fi drops broadcasts unless an app asks for them. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Voice search: Google TV's recognizer listens on the remote's microphone for us (VoiceInput). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Updates from GitHub releases, when asked in the gear menu (Updater). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Granted over adb only (scripts/install.sh): the launcher re-enables its remote-buttons service (KeysService). -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Lampa's home-screen rows («Продолжить просмотр», plugin rows) live in the TV provider. Granted with
         `pm grant ru.homescreen.tv com.android.providers.tv.permission.READ_EPG_DATA` at install. -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+ package visibility: without these the app list comes up empty. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="top.rootu.lampa" />
        <!-- Speech recognizers: Google TV's (katniss) is picked over Google's speech synthesis app. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- Showy and its sources answer over plain http, some on bare IP addresses, hence usesCleartextTraffic. -->
    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Home"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|locale|layoutDirection"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Also an app among the others: Google TV lists only LEANBACK_LAUNCHER ones. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- homescreen://back: the «Подборки» plugin in Lampa brings the launcher back after playback, leaving
                 Lampa warm in the background instead of closing it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="homescreen" />
            </intent-filter>
        </activity>

        <!-- The built-in player: two subtitle languages at once from a file's own tracks; see PlayerActivity. -->
        <activity
            android:name=".PlayerActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- The assistant role: the remote's microphone button opens the launcher's voice search; see Assistant. -->
        <service
            android:name=".Assistant"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/assistant" />
        </service>
        <service
            android:name=".AssistantSessions"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service
            android:name=".AssistantRecognizer"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>

        <!-- The installer's answer to an update (Updater). -->
        <receiver
            android:name=".Updater$StatusReceiver"
            android:exported="false" />

        <!-- The remote's Settings and Input buttons, which only the stock home answered; see KeysService. -->
        <service
            android:name=".KeysService"
            android:exported="false"
            android:label="@string/keys_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/keys_service" />
        </service>
    </application>
</manifest>
